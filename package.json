{
  "name": "hound-react-ui-kit",
  "version": "1.0.0",
  "author": "Frank-Steven <FrankStevenTool@outlook.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/hound-ui-kit.cjs",
  "module": "./dist/hound-ui-kit.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/hound-ui-kit.js",
      "require": "./dist/hound-ui-kit.cjs"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "src/core/theme/state-layer.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.types.json",
    "types": "tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
